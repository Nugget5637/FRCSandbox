{
  "name": "frcsandbox",
  "private": true,
  "version": "0.0.0",
  "description": "Single-player browser sandbox for building and testing FRC-style robots against swappable game packs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @frcsandbox/client",
    "build": "npm run build --workspace @frcsandbox/client",
    "preview": "npm run preview --workspace @frcsandbox/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build",
    "packs:rebuilt": "node game-packs/rebuilt-2026/generate.mjs"
  },
  "devDependencies": {
    "prettier": "3.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
